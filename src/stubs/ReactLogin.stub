import React from 'react';
import { Head, Link } from '@inertiajs/react';

const Logo = ({ className = "w-12 h-12" }) => (
    <svg viewBox="0 0 100 100" className={className} fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M50 5L89.4019 28.75V71.25L50 95L10.5981 71.25V28.75L50 5Z" stroke="url(#paint0_linear_login)" strokeWidth="8" strokeLinejoin="round"/>
        <rect x="35" y="45" width="8" height="30" rx="2" fill="url(#paint1_linear_login)" />
        <rect x="46" y="30" width="8" height="45" rx="2" fill="white" />
        <rect x="57" y="45" width="8" height="30" rx="2" fill="url(#paint2_linear_login)" />
        <defs>
            <linearGradient id="paint0_linear_login" x1="50" y1="5" x2="50" y2="95" gradientUnits="userSpaceOnUse">
                <stop stopColor="#0EA5E9"/>
                <stop offset="1" stopColor="#2563EB"/>
            </linearGradient>
            <linearGradient id="paint1_linear_login" x1="39" y1="45" x2="39" y2="75" gradientUnits="userSpaceOnUse">
                <stop stopColor="#7DD3FC"/>
                <stop offset="1" stopColor="#0EA5E9"/>
            </linearGradient>
            <linearGradient id="paint2_linear_login" x1="61" y1="45" x2="61" y2="75" gradientUnits="userSpaceOnUse">
                <stop stopColor="#7DD3FC"/>
                <stop offset="1" stopColor="#0EA5E9"/>
            </linearGradient>
        </defs>
    </svg>
);

export default function Login() {
    return (
        <div className="min-h-screen bg-[#020617] flex items-center justify-center p-6 relative overflow-hidden">
            <Head title="Login - Domion" />
            
            {/* Background Glow */}
            <div className="absolute top-[-20%] right-[-10%] w-[50%] h-[50%] bg-blue-600/10 rounded-full blur-[120px]" />
            <div className="absolute bottom-[-20%] left-[-10%] w-[50%] h-[50%] bg-cyan-600/10 rounded-full blur-[120px]" />

            <div className="max-w-md w-full z-10">
                <div className="bg-slate-900/50 backdrop-blur-2xl p-10 rounded-[2.5rem] border border-slate-800 shadow-2xl">
                    <div className="text-center mb-10">
                        <div className="flex justify-center mb-6">
                            <Logo className="w-16 h-16" />
                        </div>
                        <h1 className="text-3xl font-black text-white tracking-tight italic">DOMION</h1>
                        <p className="text-slate-400 mt-3 font-medium">Elevate your architecture.</p>
                    </div>

                    <form className="space-y-6" onSubmit={(e) => e.preventDefault()}>
                        <div>
                            <label className="block text-sm font-bold text-slate-300 mb-2 ml-1">Email Address</label>
                            <input 
                                type="email" 
                                className="w-full px-5 py-4 bg-slate-800/50 border border-slate-700 rounded-2xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all duration-300" 
                                placeholder="admin@domion.com" 
                            />
                        </div>
                        
                        <div>
                            <div className="flex justify-between mb-2 ml-1">
                                <label className="text-sm font-bold text-slate-300">Password</label>
                                <a href="#" className="text-sm font-medium text-blue-400 hover:text-blue-300 transition-colors">Forgot?</a>
                            </div>
                            <input 
                                type="password" 
                                className="w-full px-5 py-4 bg-slate-800/50 border border-slate-700 rounded-2xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all duration-300" 
                                placeholder="••••••••" 
                            />
                        </div>

                        <Link 
                            href="/auth/dashboard" 
                            className="w-full flex justify-center py-4 px-6 rounded-2xl bg-gradient-to-r from-blue-600 to-cyan-500 text-white font-bold text-lg hover:shadow-[0_0_30px_rgba(14,165,233,0.3)] hover:-translate-y-0.5 transition-all duration-300 active:scale-95"
                        >
                            Sign In
                        </Link>

                        <div className="pt-4 text-center">
                            <Link href="/auth" className="text-sm font-bold text-slate-500 hover:text-white transition-colors">
                                ← Back to landing
                            </Link>
                        </div>
                    </form>
                </div>
                
                <p className="text-center text-slate-600 mt-8 text-sm font-medium">
                    Built for Enterprise Performance & Scalability
                </p>
            </div>
        </div>
    );
}
