<script setup lang="ts">
import { ref } from 'vue';
import { Head, Link, useForm } from '@inertiajs/vue3';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { ArrowRight, User, Mail, Lock, Eye, EyeOff, CheckCircle2 } from 'lucide-vue-next';

const showPassword = ref(false);
const showConfirmPassword = ref(false);

const form = useForm({
    name: '',
    email: '',
    password: '',
    password_confirmation: '',
});

const submit = () => {
    form.post(route('register'));
};

const benefits = [
    'Free forever for personal use',
    'Full access to all features',
    'Community support included',
];
</script>

<template>
    <div class="min-h-screen bg-gradient-to-br from-slate-100 via-blue-50 to-cyan-50 flex flex-col">
        <Head title="Create Account" />

        <!-- Header -->
        <header class="py-6">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <Link :href="route('home')" class="flex items-center gap-3 w-fit">
                    <img src="/images/logo.png" alt="Domion" class="h-10 w-10" />
                    <span class="font-bold text-xl bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">
                        Domion
                    </span>
                </Link>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1 flex items-center justify-center px-4 py-12">
            <div class="w-full max-w-md">
                <!-- Decorative background -->
                <div class="absolute inset-0 -z-10 overflow-hidden">
                    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-400/20 rounded-full blur-3xl" />
                    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-400/20 rounded-full blur-3xl" />
                </div>

                <Card class="border-0 shadow-2xl shadow-blue-500/10 bg-white/80 backdrop-blur-sm">
                    <CardHeader class="text-center pb-0">
                        <div class="mx-auto mb-4 h-16 w-16 rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-blue-500/30">
                            <User class="h-8 w-8 text-white" />
                        </div>
                        <CardTitle class="text-2xl font-bold">Create your account</CardTitle>
                        <CardDescription class="text-slate-500">
                            Start building with Domion today
                        </CardDescription>
                    </CardHeader>

                    <CardContent class="pt-6">
                        <!-- Benefits -->
                        <div class="mb-6 p-4 rounded-xl bg-gradient-to-r from-blue-50 to-cyan-50 border border-blue-100">
                            <div class="space-y-2">
                                <div v-for="(benefit, i) in benefits" :key="i" class="flex items-center gap-2 text-sm text-slate-600">
                                    <CheckCircle2 class="h-4 w-4 text-green-500 flex-shrink-0" />
                                    <span>{{ benefit }}</span>
                                </div>
                            </div>
                        </div>

                        <form @submit.prevent="submit" class="space-y-4">
                            <div class="space-y-2">
                                <Label for="name" class="text-slate-700">Full Name</Label>
                                <div class="relative">
                                    <User class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
                                    <Input
                                        id="name"
                                        type="text"
                                        placeholder="John Doe"
                                        v-model="form.name"
                                        class="pl-10 border-slate-200 focus:border-blue-400 focus:ring-blue-400"
                                    />
                                </div>
                                <p v-if="form.errors.name" class="text-sm text-red-500">{{ form.errors.name }}</p>
                            </div>

                            <div class="space-y-2">
                                <Label for="email" class="text-slate-700">Email</Label>
                                <div class="relative">
                                    <Mail class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
                                    <Input
                                        id="email"
                                        type="email"
                                        placeholder="you@example.com"
                                        v-model="form.email"
                                        class="pl-10 border-slate-200 focus:border-blue-400 focus:ring-blue-400"
                                    />
                                </div>
                                <p v-if="form.errors.email" class="text-sm text-red-500">{{ form.errors.email }}</p>
                            </div>

                            <div class="space-y-2">
                                <Label for="password" class="text-slate-700">Password</Label>
                                <div class="relative">
                                    <Lock class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
                                    <Input
                                        id="password"
                                        :type="showPassword ? 'text' : 'password'"
                                        placeholder="••••••••"
                                        v-model="form.password"
                                        class="pl-10 pr-10 border-slate-200 focus:border-blue-400 focus:ring-blue-400"
                                    />
                                    <button
                                        type="button"
                                        @click="showPassword = !showPassword"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600"
                                    >
                                        <EyeOff v-if="showPassword" class="h-4 w-4" />
                                        <Eye v-else class="h-4 w-4" />
                                    </button>
                                </div>
                                <p v-if="form.errors.password" class="text-sm text-red-500">{{ form.errors.password }}</p>
                            </div>

                            <div class="space-y-2">
                                <Label for="password_confirmation" class="text-slate-700">Confirm Password</Label>
                                <div class="relative">
                                    <Lock class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
                                    <Input
                                        id="password_confirmation"
                                        :type="showConfirmPassword ? 'text' : 'password'"
                                        placeholder="••••••••"
                                        v-model="form.password_confirmation"
                                        class="pl-10 pr-10 border-slate-200 focus:border-blue-400 focus:ring-blue-400"
                                    />
                                    <button
                                        type="button"
                                        @click="showConfirmPassword = !showConfirmPassword"
                                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600"
                                    >
                                        <EyeOff v-if="showConfirmPassword" class="h-4 w-4" />
                                        <Eye v-else class="h-4 w-4" />
                                    </button>
                                </div>
                            </div>

                            <Button
                                type="submit"
                                :disabled="form.processing"
                                class="w-full bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 text-white shadow-lg shadow-blue-500/25"
                            >
                                {{ form.processing ? 'Creating account...' : 'Create account' }}
                                <ArrowRight class="ml-2 h-4 w-4" />
                            </Button>
                        </form>

                        <div class="mt-6 text-center">
                            <p class="text-slate-600">
                                Already have an account?
                                <Link :href="route('login')" class="text-blue-600 hover:text-blue-700 font-medium hover:underline">
                                    Sign in
                                </Link>
                            </p>
                        </div>
                    </CardContent>
                </Card>
            </div>
        </main>

        <!-- Footer -->
        <footer class="py-6">
            <div class="text-center text-sm text-slate-500">
                © {{ new Date().getFullYear() }} Domion. All rights reserved.
            </div>
        </footer>
    </div>
</template>
