import { InertiaLinkProps, Link } from '@inertiajs/react';
import { cn } from '@/lib/utils';

interface TextLinkProps extends InertiaLinkProps {
    className?: string;
}

export function TextLink({ className, children, ...props }: TextLinkProps) {
    return (
        <Link
            className={cn(
                'text-foreground underline decoration-neutral-300 underline-offset-4 transition-colors duration-150 ease-in-out hover:decoration-current dark:decoration-neutral-500',
                className
            )}
            {...props}
        >
            {children}
        </Link>
    );
}
