<div class="min-h-screen flex items-center justify-center bg-zinc-50 dark:bg-zinc-900 p-4">
    <div class="w-full max-w-md">
        <flux:card class="p-8">
            <div class="text-center mb-8">
                <div class="flex justify-center mb-4">
                    <div class="h-12 w-12 rounded-xl bg-primary flex items-center justify-center">
                        <flux:icon.lock-closed class="size-6 text-white" />
                    </div>
                </div>
                <flux:heading size="xl">Reset password</flux:heading>
                <flux:subheading>Enter your new password below</flux:subheading>
            </div>

            <form wire:submit="resetPassword" class="space-y-6">
                <flux:input
                    wire:model="email"
                    label="Email"
                    type="email"
                    disabled
                    class="bg-zinc-100 dark:bg-zinc-800"
                />

                <flux:input
                    wire:model="password"
                    label="New Password"
                    type="password"
                    placeholder="••••••••"
                    autofocus
                />

                <flux:input
                    wire:model="password_confirmation"
                    label="Confirm New Password"
                    type="password"
                    placeholder="••••••••"
                />

                <flux:button type="submit" variant="primary" class="w-full">
                    <flux:icon.lock-closed class="size-4 mr-2" wire:loading.remove />
                    <flux:icon.loading class="size-4 mr-2" wire:loading />
                    Reset password
                </flux:button>
            </form>
        </flux:card>
    </div>
</div>
