<?php

declare(strict_types=1);

namespace {{namespace}};

use {{dtoNamespace}}\LoginDto;
use {{repositoryNamespace}}\UserRepository;
use Samushi\Domion\Actions\ActionFactory;
use Samushi\Domion\Support\Traits\HasLoginActionResponse;

class LoginAction extends ActionFactory
{
    use HasLoginActionResponse;

    /**
     * Handle the login action.
     *
     * @param LoginDto $dto
     * @return mixed
     */
    protected function handle(LoginDto $dto): mixed
    {
        return $this
            ->withRepository(UserRepository::class)
            ->responseToSessionLogin($dto->email, $dto->password, $dto->remember);
    }
}
