<div class="min-h-screen flex items-center justify-center bg-zinc-50 dark:bg-zinc-900 p-4">
    <div class="w-full max-w-md">
        <flux:card class="p-8">
            <div class="text-center mb-8">
                <div class="flex justify-center mb-4">
                    <div class="h-12 w-12 rounded-xl bg-primary flex items-center justify-center">
                        <flux:icon.user-plus class="size-6 text-white" />
                    </div>
                </div>
                <flux:heading size="xl">Create an account</flux:heading>
                <flux:subheading>Enter your information to get started</flux:subheading>
            </div>

            <form wire:submit="register" class="space-y-6">
                <flux:input
                    wire:model="name"
                    label="Full Name"
                    type="text"
                    placeholder="John Doe"
                    autofocus
                />

                <flux:input
                    wire:model="email"
                    label="Email"
                    type="email"
                    placeholder="name@example.com"
                />

                <flux:input
                    wire:model="password"
                    label="Password"
                    type="password"
                    placeholder="••••••••"
                />

                <flux:input
                    wire:model="password_confirmation"
                    label="Confirm Password"
                    type="password"
                    placeholder="••••••••"
                />

                <flux:button type="submit" variant="primary" class="w-full">
                    <flux:icon.user-plus class="size-4 mr-2" wire:loading.remove />
                    <flux:icon.loading class="size-4 mr-2" wire:loading />
                    Create account
                </flux:button>
            </form>

            <div class="mt-6 text-center">
                <flux:text size="sm" class="text-zinc-500">
                    Already have an account?
                    <flux:link href="{{ route('login') }}">Sign in</flux:link>
                </flux:text>
            </div>
        </flux:card>

        <flux:text size="xs" class="text-center mt-6 text-zinc-400">
            By creating an account, you agree to our
            <flux:link href="#">Terms of Service</flux:link>
            and
            <flux:link href="#">Privacy Policy</flux:link>
        </flux:text>
    </div>
</div>
