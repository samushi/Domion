<?php

declare(strict_types=1);

namespace {{namespace}};

use Samushi\Domion\Support\{{base_controller}};
use {{actionsNamespace}}\LoginAction;
use {{actionsNamespace}}\LogoutAction;
use {{actionsNamespace}}\RegisterAction;
use {{actionsNamespace}}\ForgotPasswordAction;
use {{actionsNamespace}}\ResetPasswordAction;
use {{dtoNamespace}}\LoginDto;
use {{dtoNamespace}}\RegisterDto;
use {{requestsNamespace}}\LoginRequest;
use {{requestsNamespace}}\RegisterRequest;
use {{requestsNamespace}}\ForgotPasswordRequest;
use {{requestsNamespace}}\ResetPasswordRequest;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Password;
use Illuminate\Validation\ValidationException;

class AuthController extends {{base_controller}}
{
    public function showLogin()
    {
        return $this->render('{{domain}}::Login');
    }

    public function login(LoginRequest $request): RedirectResponse
    {
        try {
            LoginAction::run(
                LoginDto::fromRequest($request)
            );

            return redirect()->intended(route('dashboard'));
        } catch (ValidationException $e) {
            throw $e;
        }
    }

    public function showRegister()
    {
        return $this->render('{{domain}}::Register');
    }

    public function register(RegisterRequest $request): RedirectResponse
    {
        try {
            RegisterAction::run(
                RegisterDto::fromRequest($request)
            );

            return redirect()->route('dashboard');
        } catch (ValidationException $e) {
            throw $e;
        }
    }

    public function showForgotPassword()
    {
        return $this->render('{{domain}}::ForgotPassword');
    }

    public function sendResetLink(ForgotPasswordRequest $request): RedirectResponse
    {
        $status = ForgotPasswordAction::run($request->email);

        return $status === Password::RESET_LINK_SENT
            ? back()->with('status', __($status))
            : back()->withErrors(['email' => __($status)]);
    }

    public function showResetPassword(Request $request, string $token)
    {
        return $this->render('{{domain}}::ResetPassword', [
            'token' => $token,
            'email' => $request->email,
        ]);
    }

    public function resetPassword(ResetPasswordRequest $request): RedirectResponse
    {
        $status = ResetPasswordAction::run(
            $request->only('email', 'password', 'password_confirmation', 'token')
        );

        return $status === Password::PASSWORD_RESET
            ? redirect()->route('login')->with('status', __($status))
            : back()->withErrors(['email' => [__($status)]]);
    }

    public function logout(Request $request): RedirectResponse
    {
        LogoutAction::run($request);

        return redirect()->route('landing');
    }
}
