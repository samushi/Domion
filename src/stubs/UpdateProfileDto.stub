<?php

namespace {{namespace}};

use Samushi\Domion\Support\DataObjects;

class UpdateProfileDto extends DataObjects
{
    public function __construct(
        public readonly string $name,
        public readonly string $email,
    ) {}

    public static function fromArray(array $data): static
    {
        return new static(
            name: $data['name'] ?? '',
            email: $data['email'] ?? '',
        );
    }
}
