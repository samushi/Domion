import './bootstrap';
import './app.css';
import { createApp, h } from 'vue';
import { createInertiaApp } from '@inertiajs/vue3';
import { resolvePageComponent } from 'laravel-vite-plugin/inertia-helpers';
import { ZiggyVue } from 'ziggy-js';

const appName = window.document.getElementsByTagName('title')[0]?.innerText || 'Laravel';

// Domion DDD Resolver
const domainPages = import.meta.glob('../../Domain/*/Frontend/Pages/**/*.{js,jsx,ts,tsx,vue}');

const resolveDomainPage = async (name, domainPages, defaultResolver) => {
    // 1. Try to resolve from Domains folder
    const normalizedName = name.replace('::', '/');
    if (normalizedName.includes('/')) {
        const [domain, page] = normalizedName.split('/');
        const path = Object.keys(domainPages).find(p => 
            p.toLowerCase().includes(`/domain/${domain.toLowerCase()}/frontend/pages/${page.toLowerCase()}`)
        );
        
        if (path) {
            return typeof domainPages[path] === 'function' ? domainPages[path]() : domainPages[path];
        }
    }

    // 2. Fallback to default resolver
    return defaultResolver(name);
};

createInertiaApp({
    title: (title) => `${title} - ${appName}`,
    resolve: (name) => resolveDomainPage(name, domainPages, (name) => resolvePageComponent(`./Pages/${name}.vue`, import.meta.glob('./Pages/**/*.vue'))),
    setup({ el, App, props, plugin }) {
        createApp({ render: () => h(App, props) })
            .use(plugin)
            .use(ZiggyVue)
            .mount(el);
    },
    progress: {
        color: '#4B5563',
    },
});
