<?php

declare(strict_types=1);

namespace {{namespace}};

use Samushi\Domion\Support\AbstractServiceProvider;

class DashboardServiceProvider extends AbstractServiceProvider
{
    /**
     * Set Domain name
     */
    public function setDomain(): string
    {
        return 'Dashboard';
    }

    /**
     * Route prefix - false means routes at root (/)
     * Routes define their own paths (e.g., /dashboard)
     */
    public function routePrefix(): string|false|null
    {
        return false;
    }

    /**
     * Route name prefix - false means no prefix
     * This allows route('dashboard') instead of route('dashboard.dashboard')
     */
    public function routeNamePrefix(): string|false|null
    {
        return false;
    }

    /**
     * Dashboard requires authentication
     */
    public function requiresAuth(): bool
    {
        return true;
    }
}
