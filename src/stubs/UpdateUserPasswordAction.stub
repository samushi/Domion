<?php

namespace {{namespace}};

use Samushi\Domion\Actions\ActionFactory;
use App\Domain\User\Repository\UserRepository;
use App\Domain\Settings\Dto\UpdatePasswordDto;
use Illuminate\Support\Facades\Hash;

class UpdateUserPasswordAction extends ActionFactory
{
    public function __construct(
        protected UserRepository $userRepository
    ) {}

    public function handle(int|string $userId, UpdatePasswordDto $dto): void
    {
        $this->userRepository->update([
            'password' => Hash::make($dto->password),
        ], $userId);
    }
}
