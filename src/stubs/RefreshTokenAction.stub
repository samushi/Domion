<?php

declare(strict_types=1);

namespace {{namespace}};

use {{dtoNamespace}}\RefreshTokenDto;
use {{repositoryNamespace}}\RefreshTokenRepository;
use {{userRepositoryNamespace}}\UserRepository;
use Samushi\Domion\Actions\ActionFactory;
use Samushi\Domion\Support\Traits\HasTokenResponse;
use Illuminate\Validation\ValidationException;

class RefreshTokenAction extends ActionFactory
{
    use HasTokenResponse;

    public function __construct(
        protected RefreshTokenRepository $refreshTokenRepository,
        protected UserRepository $userRepository,
    ) {
    }

    /**
     * Handle the token refresh.
     */
    protected function handle(RefreshTokenDto $dto): array
    {
        // Find refresh token
        $refreshToken = $this->refreshTokenRepository->findByToken($dto->refreshToken);

        if (!$refreshToken || $refreshToken->isExpired() || $refreshToken->isRevoked()) {
            throw ValidationException::withMessages([
                'refresh_token' => ['Invalid or expired refresh token.']
            ]);
        }

        // Get user
        $user = $this->userRepository->find($refreshToken->user_id);

        if (!$user) {
            throw ValidationException::withMessages([
                'refresh_token' => ['User not found.']
            ]);
        }

        // Revoke old refresh token
        $this->refreshTokenRepository->revoke($refreshToken->id);

        // Create new tokens
        $accessToken = $user->createToken('api-token');
        $newRefreshToken = $this->refreshTokenRepository->create([
            'user_id' => $user->id,
            'token' => bin2hex(random_bytes(32)),
            'expires_at' => now()->addDays(30),
            'ip_address' => request()->ip(),
            'user_agent' => request()->userAgent(),
        ]);

        return $this->buildTokenResponse($accessToken, $newRefreshToken, $user);
    }
}
