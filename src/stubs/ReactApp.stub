import './bootstrap';
import './app.css';
import React from 'react';
import { createRoot } from 'react-dom/client';
import { createInertiaApp } from '@inertiajs/react';
import { resolvePageComponent } from 'laravel-vite-plugin/inertia-helpers';
import { route } from 'ziggy-js';

declare global {
    interface Window {
        route: typeof route;
    }
}

window.route = route;

const appName = window.document.getElementsByTagName('title')[0]?.innerText || 'Laravel';

const domainPages = import.meta.glob('../../Domain/*/Frontend/Pages/**/*.{js,jsx,ts,tsx}');

const resolveDomainPage = async (name: string) => {
    const normalizedName = name.replace('::', '/');
    
    if (normalizedName.includes('/')) {
        const [domain, page] = normalizedName.split('/');
        const path = Object.keys(domainPages).find(p => 
            p.toLowerCase().includes(`/domain/${domain.toLowerCase()}/frontend/pages/${page.toLowerCase()}`)
        );
        
        if (path) {
            const module = await domainPages[path]();
            return (module as any).default;
        }
    }

    return resolvePageComponent(`./Pages/${name}.tsx`, import.meta.glob('./Pages/**/*.tsx'));
};

createInertiaApp({
    title: (title) => `${title} - ${appName}`,
    resolve: resolveDomainPage,
    setup({ el, App, props }) {
        const root = createRoot(el);
        root.render(<App {...props} />);
    },
    progress: {
        color: '#3b82f6',
    },
});
