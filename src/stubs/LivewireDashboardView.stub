<div class="min-h-screen bg-zinc-50 dark:bg-zinc-900">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white dark:bg-zinc-800 border-b border-zinc-200 dark:border-zinc-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-6">
                    <a href="{{ route('dashboard') }}" class="flex items-center gap-2" wire:navigate>
                        <div class="h-8 w-8 rounded-lg bg-primary flex items-center justify-center">
                            <flux:icon.squares-2x2 class="size-4 text-white" />
                        </div>
                        <span class="font-bold text-xl">Domion</span>
                    </a>

                    <nav class="hidden md:flex items-center gap-6">
                        <flux:link href="{{ route('dashboard') }}" variant="subtle" class="text-sm font-medium">
                            Dashboard
                        </flux:link>
                        <flux:link href="#" variant="ghost" class="text-sm font-medium text-zinc-500">
                            Analytics
                        </flux:link>
                        <flux:link href="#" variant="ghost" class="text-sm font-medium text-zinc-500">
                            Reports
                        </flux:link>
                        <flux:link href="#" variant="ghost" class="text-sm font-medium text-zinc-500">
                            Settings
                        </flux:link>
                    </nav>
                </div>

                <flux:dropdown>
                    <flux:button variant="ghost" class="flex items-center gap-2">
                        <flux:avatar size="sm" name="{{ $user->name }}" />
                        <span class="hidden md:inline text-sm font-medium">{{ $user->name }}</span>
                        <flux:icon.chevron-down class="size-4 text-zinc-400" />
                    </flux:button>

                    <flux:menu>
                        <flux:menu.item>
                            <div class="flex flex-col">
                                <span class="text-sm font-medium">{{ $user->name }}</span>
                                <span class="text-xs text-zinc-500">{{ $user->email }}</span>
                            </div>
                        </flux:menu.item>

                        <flux:menu.separator />

                        <flux:menu.item icon="cog-6-tooth">
                            Settings
                        </flux:menu.item>

                        <flux:menu.separator />

                        <flux:menu.item icon="arrow-right-on-rectangle" wire:click="logout" class="text-red-600">
                            Logout
                        </flux:menu.item>
                    </flux:menu>
                </flux:dropdown>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <flux:heading size="2xl">Dashboard</flux:heading>
            <flux:subheading>Welcome back, {{ $user->name }}!</flux:subheading>
        </div>

        <!-- Stats Grid -->
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 mb-8">
            <flux:card>
                <flux:card.header class="flex flex-row items-center justify-between pb-2">
                    <flux:heading size="sm">Total Revenue</flux:heading>
                    <flux:icon.credit-card class="size-4 text-zinc-400" />
                </flux:card.header>
                <flux:card.body>
                    <div class="text-2xl font-bold">$45,231.89</div>
                    <flux:text size="xs" class="text-zinc-500">+20.1% from last month</flux:text>
                </flux:card.body>
            </flux:card>

            <flux:card>
                <flux:card.header class="flex flex-row items-center justify-between pb-2">
                    <flux:heading size="sm">Active Users</flux:heading>
                    <flux:icon.users class="size-4 text-zinc-400" />
                </flux:card.header>
                <flux:card.body>
                    <div class="text-2xl font-bold">+2,350</div>
                    <flux:text size="xs" class="text-zinc-500">+180.1% from last month</flux:text>
                </flux:card.body>
            </flux:card>

            <flux:card>
                <flux:card.header class="flex flex-row items-center justify-between pb-2">
                    <flux:heading size="sm">Sales</flux:heading>
                    <flux:icon.arrow-trending-up class="size-4 text-zinc-400" />
                </flux:card.header>
                <flux:card.body>
                    <div class="text-2xl font-bold">+12,234</div>
                    <flux:text size="xs" class="text-zinc-500">+19% from last month</flux:text>
                </flux:card.body>
            </flux:card>

            <flux:card>
                <flux:card.header class="flex flex-row items-center justify-between pb-2">
                    <flux:heading size="sm">Active Now</flux:heading>
                    <flux:icon.bolt class="size-4 text-zinc-400" />
                </flux:card.header>
                <flux:card.body>
                    <div class="text-2xl font-bold">+573</div>
                    <flux:text size="xs" class="text-zinc-500">+201 since last hour</flux:text>
                </flux:card.body>
            </flux:card>
        </div>

        <!-- Content Cards -->
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-7">
            <flux:card class="lg:col-span-4">
                <flux:card.header>
                    <flux:heading>Overview</flux:heading>
                    <flux:subheading>Your performance this month</flux:subheading>
                </flux:card.header>
                <flux:card.body class="h-[300px] flex items-center justify-center">
                    <div class="text-center text-zinc-400">
                        <flux:icon.chart-bar class="size-12 mx-auto mb-4 opacity-50" />
                        <flux:text>Chart visualization goes here</flux:text>
                    </div>
                </flux:card.body>
            </flux:card>

            <flux:card class="lg:col-span-3">
                <flux:card.header>
                    <flux:heading>Recent Activity</flux:heading>
                    <flux:subheading>Your latest actions</flux:subheading>
                </flux:card.header>
                <flux:card.body>
                    <div class="space-y-4">
                        @for ($i = 1; $i <= 5; $i++)
                            <div class="flex items-center gap-4">
                                <div class="h-9 w-9 rounded-full bg-zinc-100 dark:bg-zinc-700 flex items-center justify-center">
                                    <flux:icon.bolt class="size-4" />
                                </div>
                                <div class="flex-1">
                                    <flux:text size="sm" class="font-medium">Action {{ $i }}</flux:text>
                                    <flux:text size="xs" class="text-zinc-500">2 hours ago</flux:text>
                                </div>
                            </div>
                        @endfor
                    </div>
                </flux:card.body>
            </flux:card>
        </div>
    </main>
</div>
