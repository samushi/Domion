<script setup lang="ts">
import { Head, Link, useForm, usePage } from '@inertiajs/vue3';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { ArrowRight, ArrowLeft, Mail, KeyRound } from 'lucide-vue-next';

const page = usePage();

const form = useForm({
    email: '',
});

const submit = () => {
    form.post(route('password.email'));
};
</script>

<template>
    <div class="min-h-screen bg-gradient-to-br from-slate-100 via-blue-50 to-cyan-50 flex flex-col">
        <Head title="Forgot Password" />

        <header class="py-6">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <Link :href="route('landing')" class="flex items-center gap-3 w-fit">
                    <svg viewBox="0 0 100 100" class="h-10 w-10" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#2563eb" />
                                <stop offset="50%" stop-color="#3b82f6" />
                                <stop offset="100%" stop-color="#06b6d4" />
                            </linearGradient>
                        </defs>
                        <polygon points="50,2 93,25 93,75 50,98 7,75 7,25" fill="url(#logoGradient)" />
                        <path d="M35 30 L35 70 L55 70 C70 70 75 55 75 50 C75 45 70 30 55 30 Z M45 40 L55 40 C60 40 65 45 65 50 C65 55 60 60 55 60 L45 60 Z" fill="white" opacity="0.95" />
                    </svg>
                    <span class="font-bold text-xl bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">Domion</span>
                </Link>
            </div>
        </header>

        <main class="flex-1 flex items-center justify-center px-4 py-12">
            <div class="w-full max-w-md relative">
                <div class="absolute inset-0 -z-10 overflow-hidden">
                    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-400/20 rounded-full blur-3xl" />
                    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-cyan-400/20 rounded-full blur-3xl" />
                </div>

                <Card class="border-0 shadow-2xl shadow-blue-500/10 bg-white/80 backdrop-blur-sm">
                    <CardHeader class="text-center pb-0">
                        <div class="mx-auto mb-4 h-16 w-16 rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-blue-500/30">
                            <KeyRound class="h-8 w-8 text-white" />
                        </div>
                        <CardTitle class="text-2xl font-bold">Forgot password?</CardTitle>
                        <CardDescription class="text-slate-500">No worries, we'll send you reset instructions.</CardDescription>
                    </CardHeader>

                    <CardContent class="pt-6">
                        <div v-if="page.props.status" class="mb-4 p-4 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm">
                            {{ page.props.status }}
                        </div>

                        <form @submit.prevent="submit" class="space-y-4">
                            <div class="space-y-2">
                                <Label for="email" class="text-slate-700">Email</Label>
                                <div class="relative">
                                    <Mail class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
                                    <Input id="email" type="email" placeholder="you@example.com" v-model="form.email" class="pl-10 border-slate-200 focus:border-blue-400 focus:ring-blue-400" />
                                </div>
                                <p v-if="page.props.errors?.email" class="text-sm text-red-500">{{ page.props.errors.email }}</p>
                            </div>

                            <Button type="submit" :disabled="form.processing" class="w-full bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-700 hover:to-cyan-600 text-white shadow-lg shadow-blue-500/25">
                                {{ form.processing ? 'Sending...' : 'Send reset link' }}
                                <ArrowRight class="ml-2 h-4 w-4" />
                            </Button>
                        </form>

                        <div class="mt-6 text-center">
                            <Link :href="route('login')" class="inline-flex items-center text-slate-600 hover:text-blue-600">
                                <ArrowLeft class="mr-2 h-4 w-4" />
                                Back to sign in
                            </Link>
                        </div>
                    </CardContent>
                </Card>
            </div>
        </main>

        <footer class="py-6">
            <div class="text-center text-sm text-slate-500">© {{ new Date().getFullYear() }} Domion. All rights reserved.</div>
        </footer>
    </div>
</template>
