<?php

declare(strict_types=1);

namespace {{namespace}};

use {{dtoNamespace}}\RegisterDto;
use {{repositoryNamespace}}\UserRepository;
use Samushi\Domion\Actions\ActionFactory;
use Samushi\Domion\Support\Traits\HasLoginActionResponse;
use Illuminate\Support\Facades\Hash;
use Illuminate\Auth\Events\Registered;
use Laravel\Fortify\Contracts\CreatesNewUsers;

class RegisterAction extends ActionFactory implements CreatesNewUsers
{
    use HasLoginActionResponse;

    public function __construct(
        protected UserRepository $userRepository,
    ) {
    }

    /**
     * Bridge method for Laravel Fortify.
     * Fortify handles validation via its own internal logic or a separate request.
     */
    public function create(array $input): mixed
    {
        return $this->handle(RegisterDto::fromArray($input));
    }

    /**
     * Handle the registration logic.
     * Always accepts a DTO.
     */
    protected function handle(RegisterDto $dto): mixed
    {
        $user = $this->userRepository->create([
            'name' => $dto->name,
            'email' => $dto->email,
            'password' => Hash::make($dto->password),
        ]);

        event(new Registered($user));

        auth()->login($user);

        return $user;
    }
}
