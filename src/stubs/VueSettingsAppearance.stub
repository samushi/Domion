<script setup lang="ts">
import SettingsLayout from '@/Layouts/SettingsLayout.vue';
import { useAppearance } from '@/composables/useAppearance';
import { Monitor, Moon, Sun } from 'lucide-vue-next';
import { cn } from '@/lib/utils';

const { appearance, updateAppearance } = useAppearance();

const themes = [
    { value: 'light', label: 'Light', icon: Sun },
    { value: 'dark', label: 'Dark', icon: Moon },
    { value: 'system', label: 'System', icon: Monitor },
] as const;
</script>

<template>
    <SettingsLayout>
        <div class="space-y-6">
            <div>
                <h3 class="text-lg font-medium">Appearance settings</h3>
                <p class="text-sm text-muted-foreground">
                    Update your account's appearance settings
                </p>
            </div>
            
            <div class="space-y-4">
                <div class="inline-flex items-center rounded-lg bg-muted p-1">
                    <button
                        v-for="theme in themes"
                        :key="theme.value"
                        @click="updateAppearance(theme.value)"
                        type="button"
                        :class="cn(
                            'flex items-center gap-2 rounded-md px-4 py-2 text-sm font-medium transition-all outline-none',
                            appearance === theme.value 
                                ? 'bg-background text-foreground shadow-sm' 
                                : 'text-muted-foreground hover:text-foreground'
                        )"
                    >
                        <component :is="theme.icon" class="h-4 w-4" />
                        {{ theme.label }}
                    </button>
                </div>
            </div>
        </div>
    </SettingsLayout>
</template>
