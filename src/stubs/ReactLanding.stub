        <path d="M50 5L89.4019 28.75V71.25L50 95L10.5981 71.25V28.75L50 5Z" stroke="url(#paint0_linear)" strokeWidth="8" strokeLinejoin="round"/>
        <rect x="35" y="45" width="8" height="30" rx="2" fill="url(#paint1_linear)" />
        <rect x="46" y="30" width="8" height="45" rx="2" fill="white" />
        <rect x="57" y="45" width="8" height="30" rx="2" fill="url(#paint2_linear)" />
        <defs>
            <linearGradient id="paint0_linear" x1="50" y1="5" x2="50" y2="95" gradientUnits="userSpaceOnUse">
                <stop stopColor="#0EA5E9"/>
                <stop offset="1" stopColor="#2563EB"/>
