                </p>
                
                <div className="flex flex-wrap justify-center gap-6">
                    <Link href="/login" className="group relative px-10 py-4 bg-gradient-to-br from-blue-600 to-cyan-500 rounded-2xl font-bold text-lg hover:shadow-[0_0_40px_rgba(14,165,233,0.4)] transition-all duration-300 transform hover:-translate-y-1 active:scale-95">
                        <span className="flex items-center gap-2">
                            Launch Project
                            <svg className="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                        </span>
                    </Link>
                    
                    <a href="https://github.com/samushi/domion" target="_blank" className="px-10 py-4 bg-slate-800/50 backdrop-blur-xl border border-slate-700 rounded-2xl font-bold text-lg hover:bg-slate-800 transition-colors duration-300">
                        View Source
                    </a>
                </div>
            </div>

            <div className="mt-24 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl w-full z-10">
                {[ 
                    { 
                        t: 'Domain Isolation', 
                        d: 'Zero-config domain isolation that keeps your business logic perfectly decoupled.',
                        icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4'
